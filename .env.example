# Copy this file to `.env` at the repository root and fill in real values.
# `.env` is ignored by Git. Never commit real credentials.

# Runtime
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed origins, or * for any origin.
# Admin web (Vite) default: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (Supabase PostgreSQL in production).
# Use the "Connection pooling" / pooler URI for serverless or the direct URI locally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/access_control?schema=public

# Supabase Auth (not used yet; reserved for the authentication mission).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
