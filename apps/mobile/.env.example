# Variables de entorno publicas de la app movil (prefijo EXPO_PUBLIC_).
# Copia este archivo a `.env` para sobreescribir los valores por defecto
# definidos en `src/config/env.ts`. Nunca incluyas SUPABASE_SERVICE_ROLE_KEY
# ni DATABASE_URL aqui: esta app se empaqueta en el telefono.

# URL base de la API, incluye el prefijo versionado /api/v1 (sin barra final).
EXPO_PUBLIC_API_BASE_URL=https://scaccess-api.onrender.com/api/v1

# Proyecto Supabase Auth (URL y clave publica publishable/anon).
EXPO_PUBLIC_SUPABASE_URL=https://vomjmyqxbqgndndvpaqb.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_wtHSrYnWHPT5T2yBvcXuxA_yQkTD4Ln
